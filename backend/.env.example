# Copia este archivo a backend/.env para desarrollo. En la Pi se usa
# /etc/monitor/monitor.env (lo crea deploy/pi/install.sh).
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.neon.tech/neondb?sslmode=require
# Esquema PostgreSQL propio para no chocar con otras tablas de la misma base.
DB_SCHEMA=monitor
JWT_SECRET=genera-con-python-c-import-secrets-print-secrets-token-hex-32
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=backend
MQTT_PASSWORD=
PERSIST_INTERVAL_S=10
DB_FLUSH_INTERVAL_S=15
RETENTION_DAYS=180
STALE_AFTER_S=30
# En desarrollo por HTTP la cookie no puede ser Secure:
COOKIE_SECURE=false
DEBUG=true
