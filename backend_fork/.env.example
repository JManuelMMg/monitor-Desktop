# Neon
DATABASE_URL=postgresql://usuario:password@host/db?sslmode=require
# Clave larga y aleatoria: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Administrador inicial (solo se crea si no hay usuarios)
ADMIN_USER=admin
ADMIN_PASSWORD=
# MQTT (broker en la misma Pi)
MQTT_HOST=localhost
MQTT_PORT=8883
MQTT_USER=backend
MQTT_PASSWORD=
MQTT_TLS=true
MQTT_CA_FILE=/etc/mosquitto/certs/ca.crt
# Comportamiento
PERSIST_INTERVAL_S=2
OFFLINE_AFTER_S=30
BUFFER_FILE=./data/pending_readings.jsonl
CORS_ORIGINS=*
